# Configuration Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=votre-cle-secrete-django
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Authentification Google OAuth 2.0
# Obtenez vos identifiants sur Google Cloud Console (https://console.cloud.google.com/)
# Dans la section "API et services" > "Identifiants" > "ID client OAuth" :
# URI de redirection autorisée : http://127.0.0.1:8000/auth/google/callback/ (et votre domaine de production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Configuration E-mail (facultative en dev)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-d-application
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=votre-email@gmail.com
